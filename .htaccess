# The Capitol Theatre: atthecapitol.org (generated by src/build.py; edit there, not here)
Options -Indexes
DirectoryIndex index.html
ErrorDocument 404 /404.html

<IfModule mod_rewrite.c>
RewriteEngine On
RewriteBase /

# Always use https, and drop "www." (keeps whichever address was used, e.g. new.atthecapitol.org for previews)
RewriteCond %{HTTP_HOST} ^www\.(.+)$ [NC]
RewriteRule ^(.*)$ https://%1/$1 [R=301,L]
RewriteCond %{HTTPS} !=on
RewriteRule ^(.*)$ https://%{HTTP_HOST}/$1 [R=301,L]

# Old WordPress links -> new pages
RewriteCond %{QUERY_STRING} (^|&)page_id=84(&|$)
RewriteRule ^(index\.php)?$ /tickets? [R=301,L]

RewriteCond %{QUERY_STRING} (^|&)page_id=26(&|$)
RewriteRule ^(index\.php)?$ /whats-on? [R=301,L]

RewriteCond %{QUERY_STRING} (^|&)page_id=2(&|$)
RewriteRule ^(index\.php)?$ /portal-players? [R=301,L]

RewriteCond %{QUERY_STRING} (^|&)page_id=66(&|$)
RewriteRule ^(index\.php)?$ /visit? [R=301,L]

RewriteCond %{QUERY_STRING} (^|&)page_id=51(&|$)
RewriteRule ^(index\.php)?$ /membership? [R=301,L]

RewriteCond %{QUERY_STRING} (^|&)page_id=90(&|$)
RewriteRule ^(index\.php)?$ /board? [R=301,L]

RewriteCond %{QUERY_STRING} (^|&)page_id=1163(&|$)
RewriteRule ^(index\.php)?$ /portal-players? [R=301,L]

RewriteCond %{QUERY_STRING} (^|&)page_id=92(&|$)
RewriteRule ^(index\.php)?$ /board? [R=301,L]

RewriteCond %{QUERY_STRING} (^|&)page_id=69(&|$)
RewriteRule ^(index\.php)?$ /history? [R=301,L]

RewriteCond %{QUERY_STRING} (^|&)page_id=71(&|$)
RewriteRule ^(index\.php)?$ /helen-ford? [R=301,L]

RewriteCond %{QUERY_STRING} (^|&)p=2676(&|$)
RewriteRule ^(index\.php)?$ /season? [R=301,L]

RewriteCond %{QUERY_STRING} (^|&)p=2673(&|$)
RewriteRule ^(index\.php)?$ /show-killer-bands-from-outer-space? [R=301,L]

RewriteCond %{QUERY_STRING} (^|&)p=2668(&|$)
RewriteRule ^(index\.php)?$ /show-comic-strippers? [R=301,L]

RewriteCond %{QUERY_STRING} (^|&)p=2640(&|$)
RewriteRule ^(index\.php)?$ /show-improv-comedy-rumble? [R=301,L]

RewriteCond %{QUERY_STRING} (^|&)p=2650(&|$)
RewriteRule ^(index\.php)?$ /show-dreams-arrival? [R=301,L]

RewriteCond %{QUERY_STRING} (^|&)p=2066(&|$)
RewriteRule ^(index\.php)?$ /get-involved? [R=301,L]

RewriteCond %{QUERY_STRING} (^|&)p=2168(&|$)
RewriteRule ^(index\.php)?$ /membership? [R=301,L]

# Any other old post or page
RewriteCond %{QUERY_STRING} (^|&)p=[0-9]+(&|$)
RewriteRule ^(index\.php)?$ /whats-on? [R=301,L]

RewriteCond %{QUERY_STRING} (^|&)(page_id|author|cat|m)=
RewriteRule ^(index\.php)?$ /? [R=301,L]

# Images that changed format
RewriteRule ^img/(pen-pals|comic-strippers|opening-day-1936)\.png$ /img/$1.jpg [R=301,L]

# Old links to the bylaws and constitution PDFs
RewriteRule ^wp-content/uploads/2020/10/2020\.09\.30-PPDS-Bylaw-Revisions\.pdf$ /docs/ppds-bylaws-2020.pdf [R=301,L]
RewriteRule ^wp-content/uploads/.*PPDS-Constitution.*\.pdf$ /docs/ppds-constitution-2018.pdf [R=301,L]

# Old WordPress folders and feeds
RewriteRule ^(wp-admin|wp-login\.php|wp-content|wp-includes|feed|comments)(/.*)?$ / [R=301,L]

# Clean addresses: /visit.html -> /visit (and /index.html -> /)
RewriteCond %{THE_REQUEST} \s/+(.*?/)?index\.html[\s?] [NC]
RewriteRule ^ /%1 [R=301,L]
RewriteCond %{THE_REQUEST} \s/+([^?\s]+?)\.html[\s?] [NC]
RewriteRule ^ /%1 [R=301,L]

# Drop a trailing slash on page addresses: /visit/ -> /visit
RewriteCond %{REQUEST_FILENAME} !-d
RewriteRule ^(.+)/$ /$1 [R=301,L]

# Serve /visit from visit.html
RewriteCond %{REQUEST_FILENAME} !-d
RewriteCond %{REQUEST_FILENAME}.html -f
RewriteRule ^(.+?)/?$ $1.html [L]
</IfModule>

# Compress pages, styles, scripts and text files before sending them
<IfModule mod_deflate.c>
AddOutputFilterByType DEFLATE text/html text/css text/plain text/xml application/javascript text/javascript application/json application/xml image/svg+xml image/x-icon
</IfModule>

<IfModule mod_expires.c>
ExpiresActive On
ExpiresByType text/html "access plus 10 minutes"
ExpiresByType text/css "access plus 1 year"
ExpiresByType image/png "access plus 1 month"
ExpiresByType image/jpeg "access plus 1 month"
ExpiresByType image/webp "access plus 1 month"
</IfModule>
